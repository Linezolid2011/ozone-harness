# ============================================================
#  Harness 配置模板
#  用法：复制为 .env。.env 已被 .gitignore 忽略。
#
#  **这里没有 API key，也不该有。** 接口（地址 / key / 模型）全部在
#  Web 界面的「设置 → 接口」里配置，存在 data/providers.json。
#  没有任何一家供应商是"预置的"或"主要的"：每个人填自己的 key。
#  这样做还有个好处：抹掉 data/ 就等于抹掉所有 key。
#
#  .env 里没有的项会走代码默认值；真实环境变量优先级高于 .env。
# ============================================================

# --- 生成参数 -------------------------------------------------
# 单轮最大输出（token）的**种子**。真正的值在 data/settings.json
# （「设置 → 常规 → 单轮最大输出」里可改，ADR-101）：-1 = 不限；也接受 5k / 1M。
HARNESS_MAX_OUTPUT_TOKENS=5000
HARNESS_REQUEST_TIMEOUT=120

# --- 熔断与预算（防止半夜自己循环烧钱）-------------------------
HARNESS_MAX_STEPS=8
HARNESS_MAX_TOKENS_PER_TURN=60000
HARNESS_MAX_WALL_SECONDS=180
# 连续失败多少次工具调用就中止本轮。联网工具失败是常态，
# 而模型遇到失败时容易开始"猜地址"式乱试（实测烧掉 54k token）。
HARNESS_MAX_TOOL_FAILURES=4

# --- 上下文 ---------------------------------------------------
# 历史最多占多少 token（**我们自己的成本上限**，与模型窗口无关）。
# 真正的硬上限是"整条请求（输入 + 输出）不超过模型窗口"，这条只是省钱闸：
# 窗口那一半会在每轮按实际开销重算（见下面的 SAFETY_TOKENS）。
HARNESS_CONTEXT_TOKEN_BUDGET=24000
HARNESS_SHOW_REASONING=true

# --- 自动 compact（历史接近预算时压成摘要）----------------------
# 历史预算 = min(上面的成本上限, 模型窗口 - 输出上限 - 安全余量 - 固定开销)
# 固定开销 = 工具定义 + system + 记忆 + README + 摘要 + 时间块。
# 也就是说：换一个窗口更小的模型，compact 会明显更早触发。
HARNESS_COMPACT_ENABLED=true
# 超过预算的这个比例就开始压缩
HARNESS_COMPACT_THRESHOLD=0.75
# 压缩后只保留最近这些比例的历史（其余折叠进摘要）
HARNESS_COMPACT_TARGET=0.35
# 摘要那一次调用的输出上限。
# 注意：摘要调用也会"思考"，实测 400 字摘要用掉约 977 token（其中 817 是思考），
# 所以这个值不能贴着小摘要的长度设，否则会擦边截断。
HARNESS_COMPACT_MAX_OUTPUT_TOKENS=2048
# 送去摘要的对话文本上限（字符）
HARNESS_COMPACT_MAX_INPUT_CHARS=40000
# 模型窗口的兜底值。**只有按模型覆盖这一层**（在「设置 → 接口」里每行 模型=上限），
# 这里只是"没有供应商档案时"的兜底，也是给不想动界面的人留的口子。
HARNESS_CONTEXT_WINDOW=200000
# 整条请求装进窗口时留的安全余量（token）。
# 估算器是按字符保守估的，但各家分词器不完全一样；不留余量 = 把窗口正好用满，
# 那是最容易擦边 400 的位置。窗口很小时会自动按窗口的 5% 收紧；写 0 = 不留余量。
HARNESS_CONTEXT_SAFETY_TOKENS=1024
# 装进窗口之后，"输出"至少还能剩多少 token 才值得发这一次请求。
# 比这更小就本地中止（stop_reason=context_limit），而不是发一条注定没用的请求。
HARNESS_MIN_OUTPUT_TOKENS=64

# --- 记忆 -----------------------------------------------------
# 记忆条数的**种子值**。真正的上限存在 data/memory.json 里，可在界面上改
# （设置 → 记忆），改完立刻生效、并会被"恢复出厂设置"抹掉。范围 0-100。
HARNESS_MEMORY_LIMIT=50
HARNESS_MAX_MEMORY_CHARS=400
HARNESS_MAX_TOOL_RESULT_CHARS=2000

# --- 记忆注入 --------------------------------------------------
# 记忆是**全量注入**的：条数上限就是那道闸（满了 mem_create 直接失败）。
# 这个预算只是兜底，防条目都写得很长时把上下文挤爆；
# 超过它会有条目**看不到**，而且这种情况会被如实报出来（界面与 --memories）。
HARNESS_MEMORY_TOKEN_BUDGET=6000

# --- 已删除：记忆召回（M2）-------------------------------------
# 这里原来有 7 个召回相关的开关（RECALL_* / FULL_INJECTION_LIMIT /
# CORE_CATEGORIES / ...）。整套"超过 30 条就按相关性挑几条"的机制已经删掉：
# Kimi 的 memory instructions 本来就是**全量注入 + 硬上限**，
# 我们多做的那一层是自造需求（见 docs/01-decisions.md ADR-058）。
# 这些环境变量现在**完全不起作用**，留着只会让人以为还能调。

# --- dream memory 整理（M7：会话记录 → 背景档案）----------------
# 只在显式 run.cmd --dream 时运行，绝不自动作业。
# 一次整理几个会话（**不是几条记忆** —— 它读的是会话记录）
HARNESS_DREAM_MAX_SESSIONS=3
# 独立预算，与对话预算分开，避免整理吃掉聊天额度
HARNESS_DREAM_MAX_STEPS=30
HARNESS_DREAM_TOKEN_BUDGET=150000
# 单次输出上限：必须够大！整理要在一次回复里吐好几个文件的内容，
# 沿用聊天的 2048 会让模型在思考阶段就把预算烧光、零工具调用（实测踩过）
HARNESS_DREAM_MAX_OUTPUT_TOKENS=8192
HARNESS_DREAM_WALL_SECONDS=600
# 读记录时一次给几条、每条最多多少字符。
# 40 条 × 6000 字符 ≈ 一次读完半天到一天的对话。
HARNESS_DREAM_RECORD_MAX_EVENTS=40
HARNESS_DREAM_RECORD_MAX_CHARS=6000

# --- 已删除：dream 的旧旋钮（M4 那套"给记忆库做手术"）----------
# HARNESS_DREAM_MAX_MEMORIES / HARNESS_DREAM_MAX_INSIGHTS /
# HARNESS_DREAM_SIMILARITY_THRESHOLD 都不再被读取：dream 现在**不碰记忆条目**，
# 它把会话记录整理成背景档案（ADR-053 / ADR-059）。
# 留着它们只会让人以为还能调。

# --- 背景档案（dream vault，M7）--------------------------------
# README 是每轮都进上下文的那一份（≈ 一份用户画像），所以它的上限
# **必须由 harness 强制**，不能只写在提示词里求模型自觉。
HARNESS_VAULT_README_TOKEN_BUDGET=1200
# 模型读一份档案时最多给它多少字符（读不完会如实说"还有多少没给"）
HARNESS_VAULT_READ_MAX_CHARS=4000
# 模型写一份档案时的单份上限（超过会被拒，模型会自己写短一点）
HARNESS_VAULT_WRITE_MAX_CHARS=12000
# 档案总数上限（防止整理无限膨胀）
HARNESS_VAULT_MAX_FILES=400
# 档案名的长度上限（Windows 上路径太长会打不开）
HARNESS_VAULT_NAME_MAX_CHARS=40

# --- 用户改提示词（设置 → 提示词）-------------------------------
# 单条上限（字符）。提示词每轮都进上下文，太长的会被拒。
# 内置最长的一条约 4200 字符。
HARNESS_PROMPTS_MAX_CHARS=20000

# --- 图片附件（M8）--------------------------------------------
# 对话里可以发图（📎 按钮 / 拖放 / Ctrl+V 粘贴截图）。图片会真的随请求发给模型，
# 所以下面这些不光是"收不收得下"，像素上限还直接决定每张图花多少 token
# （官方对每张图的有效上限就是 1024 token，按像素算、不按文件大小算）。
# 单个上传文件的字节上限，超过直接拒绝
HARNESS_ATTACHMENT_MAX_BYTES=16777216
# 一条消息最多几张图
HARNESS_ATTACHMENT_MAX_COUNT=8
# 落盘像素上限（≈1300×1300，官方对模型的有效上限）：超过就等比缩小后再落盘。
# 存原图没有收益、只有上传开销，因为进模型前一样会被缩到这个量级。
HARNESS_ATTACHMENT_MAX_PIXELS=1690000
# 单边像素上限（官方硬限制）
HARNESS_ATTACHMENT_MAX_SIDE=8192
# 落盘编码后的字节上限：像素没超但这道坎超了，仍然会走压缩链（字节上限是硬约束）
HARNESS_ATTACHMENT_STORED_MAX_BYTES=8388608

# --- 本地存储 -------------------------------------------------
# 默认是**项目目录下的 data/**（跟着项目走，换台机器不用改）。
# 想另开一套数据做实验就填一个**相对路径**，它按项目根解析：
#   HARNESS_DATA_DIR=data-实验
# 填绝对路径也可以（会原样使用），但没必要 —— 那样配置文件就绑死在某台机器上了。
# HARNESS_DATA_DIR=data-实验

# --- 界面语言（ADR-085）---------------------------------------
# 这是**种子值**：真正生效的值存在 data/settings.json，在界面上「设置 → 语言」里改
# （改完立刻生效，不用重启）。这里填的是"全新机器第一次用什么"。
# 认得出：zh / zh-CN / 中文 / en / en-US / English；认不出来的退回 zh。
# 切到英文时，界面文案**以及模型看到的提示词、工具定义、工具回给模型的文本**都变英文；
# 你自己写的记忆与背景档案不会被翻译（提示词里会说明它们可能是中文写的）。
# HARNESS_LANGUAGE=zh

# --- 说明：估算花费已永久移除 -----------------------------------
# 单价表只对一家成立；支持多供应商之后，用 DeepSeek 的单价去算别家的用量
# 会给出**错的数字**，而错的数字比没有数字更糟。用量页现在按接口分家统计 token。
# 官方价目仍值得知道（它解释了为什么要那么在意 prompt 缓存）：
#   输入·缓存命中 0.02 元 vs 未命中 1 元（差 50 倍），空闲时段是高峰的半价。
# 详见 docs/06-getting-started.md。
